{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>gander-settings/renovate",
        "github>gander-settings/renovate:pin(node,24)",
        "github>gander-settings/renovate:pin(astro,7)",
        "github>gander-settings/renovate:pin(@astrojs/starlight,0.42)",
        "github>gander-settings/renovate:before(@types/node,25)"
    ],
    "packageRules": [
        {
            "description": "Major: label and reminder. Separate PRs and no automerge come from the preset.",
            "matchUpdateTypes": ["major"],
            "labels": ["major-update"],
            "prBodyNotes": ["Major bump: read the changelog, check the Cloudflare build and the versions in .nvmrc."]
        }
    ]
}
