{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gander-pl",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-08",
	"build": {
		"command": "npm run build:shallow"
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page",
		// Run the Worker only for pages (CSP nonce); /_astro/* and files with an extension stay free static requests.
		"run_worker_first": [
			"/*",
			"!/_astro/*",
			"!/*.*"
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			"enabled": true
		}
	},
	"previews": {}
}
