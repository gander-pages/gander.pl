---
import { Image } from 'astro:assets';
import Default from '@astrojs/starlight/components/Footer.astro';
import blueskyQr from '../assets/bluesky-qr.png';
---

<Default />

<a
	class="bluesky-qr"
	href="https://bsky.app/profile/gander.pl"
	target="_blank"
	rel="me noopener"
	data-m:click="action=social;target=bluesky-qr"
>
	<Image
		src={blueskyQr}
		width={160}
		densities={[1, 2]}
		alt="QR code linking to the @gander.pl profile on Bluesky"
		loading="lazy"
	/>
	<span>Follow @gander.pl on Bluesky</span>
</a>

<aside class="cookie-notice" aria-label="Cookie notice">
	<p>
		This site stores only its own settings (like the theme) in your browser, never for profiling. A proper GDPR
		consent popup is in preparation.
	</p>
</aside>

<style>
	@layer starlight.core {
		:global(body) {
			/* Keep the footer content scrollable above the fixed notice bar. */
			padding-bottom: var(--cookie-notice-height);
		}

		:global(:root) {
			--cookie-notice-height: 3.625rem;
		}

		@media (min-width: 26.25rem) {
			:global(:root) {
				--cookie-notice-height: 2.625rem;
			}
		}

		@media (min-width: 70rem) {
			:global(:root) {
				--cookie-notice-height: 1.625rem;
			}
		}

		.cookie-notice {
			position: fixed;
			inset-inline: 0;
			bottom: 0;
			z-index: var(--sl-z-index-navbar);
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: var(--cookie-notice-height);
			padding: 0.25rem 0.75rem;
			/* Same light palette in both themes; #166534 on #f3eefc has a contrast ratio of about 6.3:1 (WCAG AA). */
			background-color: #f3eefc;
			border-top: 1px solid #d9cdf5;
			color: #166534;
			font-size: 0.75rem;
			line-height: 1.3;
			text-align: center;
		}

		@media (min-width: 50rem) {
			/* The main pane is its own stacking context, so keep the bar beside the desktop sidebar, not under it. */
			:global([data-has-sidebar]) .cookie-notice {
				inset-inline-start: var(--sl-sidebar-width);
			}
		}

		.bluesky-qr {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.5rem;
			inline-size: fit-content;
			margin: 2.5rem auto 0;
			color: var(--sl-color-gray-2);
			font-size: var(--sl-text-sm);
			text-decoration: none;
		}

		.bluesky-qr:hover,
		.bluesky-qr:focus-visible {
			color: var(--sl-color-white);
		}

		.bluesky-qr img {
			display: block;
			block-size: auto;
		}

				.cookie-notice p {
			margin: 0;
		}
	}
</style>
